{
  "manifest_version": 3,
  "name": "Udemy Dark",
  "version": "0.1.0",
  "description": "A dark theme for Udemy, including the course player.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.udemy.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.udemy.com/*"
      ],
      "css": [
        "dark.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_title": "Udemy Dark"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
